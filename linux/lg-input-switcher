def parse_hotkey(s):
    # "Ctrl+Alt+1" -> (frozenset({"ctrl", "alt"}), 2), or None if not understood.
    mods, key = set(), None
    for token in (s or "").split("+"):
        t = token.strip().lower()
        if t in MODIFIERS:
            mods.add({"control": "ctrl", "windows": "win", "meta": "win", "super": "win"}.get(t, t))
        elif t in KEY_CODES and key is None:
            key = KEY_CODES[t]
        else:
            return None
    return (frozenset(mods), key) if key is not None else None


# --- I2C / DDC ---------------------------------------------------------------------------------

I2C_SLAVE = 0x0703
I2C_SLAVE_FORCE = 0x0706
EDID_ADDRESS = 0x50
DDC_ADDRESS = 0x37             # 7-bit; 0x6E / 0x6F on the wire
DDC_WRITE_ADDRESS = 0x6E
LG_SOURCE_ADDRESS = 0x50
STD_SOURCE_ADDRESS = 0x51
LG_INPUT_VCP = 0xF4


class I2cBus:
    def __init__(self, number):
        import fcntl  # Linux only; imported here so the rest can be tested anywhere
        self._ioctl = fcntl.ioctl
        self.number = number
        self.path = "/dev/i2c-%d" % number
        self.fd = os.open(self.path, os.O_RDWR)
        self._address = None

    def _select(self, address):
        if self._address == address:
            return
        try:
            self._ioctl(self.fd, I2C_SLAVE, address)
        except OSError as e:
            if e.errno != errno.EBUSY:
                raise
            self._ioctl(self.fd, I2C_SLAVE_FORCE, address)  # a kernel driver has claimed it
        self._address = address

    def write(self, address, data):
        self._select(address)
        os.write(self.fd, bytes(data))

    def read(self, address, length):
        self._select(address)
        data = os.read(self.fd, length)
        if len(data) != length:
            raise OSError(errno.EIO, "short read")
        return data

    def close(self):
        os.close(self.fd)


def _sysfs_i2c(number, name):
    try:
        with open("/sys/bus/i2c/devices/i2c-%d/%s" % (number, name)) as f:
            return f.read().strip()
    except OSError:
        return ""


def is_display_bus(number):
    # Only buses that belong to a graphics card (PCI class 0x03xxxx). Others, like the
    # motherboard's SMBus, have RAM and sensor chips that must not be poked.
    path = os.path.realpath("/sys/bus/i2c/devices/i2c-%d" % number)
    while path not in ("/", "/sys", "/sys/devices"):
        try:
            with open(os.path.join(path, "class")) as f:
                return f.read().strip().startswith("0x03")
        except OSError:
            path = os.path.dirname(path)
    return False


def i2c_bus_numbers():
    nums = []
    for p in glob.glob("/dev/i2c-*"):
        m = re.match(r"/dev/i2c-(\d+)$", p)
        if m:
            nums.append(int(m.group(1)))
    return sorted(nums)


def parse_edid_id(edid):
    if edid is None or len(edid) < 12:
        return None
    m = (edid[8] << 8) | edid[9]
    letters = "".join(chr(ord("A") - 1 + ((m >> s) & 0x1F)) for s in (10, 5, 0))
    return "%s%04X" % (letters, edid[10] | (edid[11] << 8))


def parse_edid_name(edid):
    # Four 18-byte descriptors at 54; tag 0xFC is the monitor name.
    for off in range(54, 126 - 17, 18):
        if off + 18 <= len(edid) and edid[off] == 0 and edid[off + 1] == 0 and edid[off + 3] == 0xFC:
            name = bytes(edid[off + 5:off + 18]).split(b"\n")[0]
            return name.decode("ascii", "replace").strip()
    return None


class DisplayInfo:
    def __init__(self, bus, adapter, edid_id, name):
        self.bus, self.adapter, self.edid_id, self.name = bus, adapter, edid_id, name


def list_displays(problems=None):
    # Reads the EDID of every graphics-card I2C bus. problems collects buses that couldn't be opened.
    result = []
    for n in i2c_bus_numbers():
        if not is_display_bus(n):
            continue
        try:
            bus = I2cBus(n)
        except OSError as e:
            if problems is not None:
                problems.append((n, e))
            continue
        try:
            bus.write(EDID_ADDRESS, [0])
            edid = bus.read(EDID_ADDRESS, 128)
            if edid[:8] == b"\x00\xff\xff\xff\xff\xff\xff\x00":
                result.append(DisplayInfo(n, _sysfs_i2c(n, "name"), parse_edid_id(edid), parse_edid_name(edid)))
        except OSError:
            pass  # nothing connected to this port
        finally:
            bus.close()
    return result


def access_help(problems):
    if not i2c_bus_numbers():
        return ("No /dev/i2c-* devices. Load the i2c-dev module:\n"
                "  sudo modprobe i2c-dev\n"
                "  echo i2c-dev | sudo tee /etc/modules-load.d/i2c-dev.conf")
    if any(e.errno in (errno.EACCES, errno.EPERM) for _, e in problems):
        return ("No permission to use /dev/i2c-*. Run \"lg-input-switcher doctor\" for the fix.")
    return None


def checksum(dev_address, source, data):
    chk = dev_address ^ source
    for b in data[:-1]:
        chk ^= b
    return chk & 0xFF


def reply_checksum_ok(reply):
    length = reply[1] & 0x7F
    if length + 3 > len(reply):
        return False
    chk = 0x50  # replies are checksummed against the host's virtual address 0x50
    for b in reply[:length + 2]:
        chk ^= b
    return chk == reply[length + 2]


class LgSwitcher:
    def __init__(self, edid_id, open_bus=I2cBus, displays=list_displays):
        self.edid_id = (edid_id or "").upper()
        self._open_bus = open_bus
        self._displays = displays
        self._display = None
        self._bus = None

    def find_monitor(self, refresh=False):
        # The bus is kept open; it's looked up again only after a transfer failed.
        if self._bus is not None and not refresh:
            return self._display
        self.close()
        problems = []
        found = [d for d in self._displays(problems) if d.edid_id]
        match = [d for d in found if d.edid_id.upper() == self.edid_id] if self.edid_id else \
                [d for d in found if d.edid_id.upper().startswith("GSM")]  # GSM = LG (GoldStar)
        if not match and self._display is not None:
            match = [self._display]  # not reported right now; keep using the last known bus
        if not match:
            want = "Monitor " + self.edid_id if self.edid_id else "An LG monitor"
            if found:
                hint = "Monitors found: " + ", ".join("%s (%s)" % (d.edid_id, d.name or "?") for d in found)
            else:
                hint = access_help(problems) or "No monitor answered on the graphics card's DDC buses."
            raise SwitchError("%s was not found. %s" % (want, hint))
        self._display = match[0]
        self._bus = self._open_bus(match[0].bus)
        return self._display

    def close(self):
        if self._bus is not None:
            try:
                self._bus.close()
            except OSError:
                pass
        self._bus = None

    def switch_input(self, value):
        # 0x84 = 0x80 | 4 data bytes, 0x03 = Set VCP Feature, VCP code, value high, value low, checksum
        data = [0x84, 0x03, LG_INPUT_VCP, 0x00, value, 0x00]
        data[-1] = checksum(DDC_WRITE_ADDRESS, LG_SOURCE_ADDRESS, data)
        last = None
        for attempt in range(3):
            try:
                self.find_monitor(attempt > 0)
                self._bus.write(DDC_ADDRESS, [LG_SOURCE_ADDRESS] + data)
                return self._display
            except OSError as e:
                log("I2C write attempt %d failed: %s", attempt + 1, e)
                last = e
                time.sleep(0.1)
        raise SwitchError("I2C write failed: %s" % last)

    # Always sends the switch: the LG's VCP 0x60 keeps reporting the DisplayPort input it's
    # queried over even while it shows HDMI, so the current input can't be known.
    def switch_to(self, inp):
        if inp.lg_value is None:
            raise SwitchError("Don't know LG's switch code for " + inp.label)
        self.switch_input(inp.lg_value)

    def _request(self, source, payload, reply_length, delay):
        # Sends a DDC/CI request and reads the reply. A length byte of 0x80 is a null message
        # (monitor busy) and a bad checksum is a garbled read; both are retried.
        data = [0x80 | len(payload)] + list(payload) + [0]
        data[-1] = checksum(DDC_WRITE_ADDRESS, source, data)
        failed = False
        reply = b""
        for attempt in range(5):
            try:
                self.find_monitor(failed)
                self._bus.write(DDC_ADDRESS, [source] + data)
                time.sleep(delay)
                reply = self._bus.read(DDC_ADDRESS, reply_length)
                failed = False
            except OSError:
                if attempt == 4:
                    raise
                failed = True
                time.sleep(0.1)
                continue
            if reply[1] != 0x80 and reply_checksum_ok(reply):
                return reply
            time.sleep(0.1)
        raise SwitchError("No valid DDC reply: " + reply.hex("-").upper())

    def read_vcp(self, vcp):
        # DDC/CI "Get VCP Feature". Returns (current, max).
        # Reply: src(0x6E) len(0x88) 0x02 result vcp type maxH maxL curH curL chk
        r = self._request(STD_SOURCE_ADDRESS, [0x01, vcp], 11, 0.04)
        if r[2] != 0x02 or r[4] != vcp:
            raise SwitchError("Unexpected DDC reply: " + r.hex("-").upper())
        if r[3] != 0x00:
            raise SwitchError("Monitor reports VCP 0x%02X unsupported" % vcp)
        return (r[8] << 8) | r[9], (r[6] << 8) | r[7]

    def read_capabilities(self):
        # DDC/CI "Capabilities Request", read in fragments, e.g. "(prot(monitor)type(LCD)model(...)vcp(10 12 60(0F 11 12) ...))".
        out = []
        offset = 0
        while offset < 4096:
            # Reply: src len 0xE3 offH offL data... chk (up to 32 data bytes)
            r = self._request(STD_SOURCE_ADDRESS, [0xF3, offset >> 8, offset & 0xFF], 38, 0.06)
            length = (r[1] & 0x7F) - 3
            if r[2] != 0xE3 or length < 0 or length > 32 or ((r[3] << 8) | r[4]) != offset:
                raise SwitchError("Unexpected capabilities reply: " + r.hex("-").upper())
            if length == 0:
                break
            out.extend(chr(b) for b in r[5:5 + length] if 0x20 <= b < 0x7F)
            offset += length
        return "".join(out)

    def detect(self):
        # Model name and the inputs the monitor reports (VCP 0x60 values in its capabilities string).
        d = self.find_monitor()
        caps = self.read_capabilities()
        m = re.search(r"model\(([^)]*)\)", caps)
        model = (d.name or d.edid_id) + (" (%s)" % m.group(1).strip() if m else "")
        v = re.search(r"(?<![0-9A-Fa-f])60\(([0-9A-Fa-f ]*)\)", caps)
        if not v:
            raise SwitchError("Monitor doesn't report its inputs: " + caps)
        return d, model, [int(c, 16) for c in v.group(1).split()]


def detect_into(cfg, switcher):
    d, model, inputs = switcher.detect()
    cfg.edid_id, cfg.model, cfg.input_codes = d.edid_id, model, inputs
    cfg.save()
    return cfg



def _x11_auth_files():
    files = [os.environ.get("XAUTHORITY", "")]
    run = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    # KDE's and GNOME's Xwayland cookies, newest first, then the classic file.
    files += sorted(glob.glob(os.path.join(run, "xauth_*")) + glob.glob(os.path.join(run, ".mutter-Xwaylandauth.*")),
                    key=lambda p: -os.path.getmtime(p) if os.path.exists(p) else 0)
    files.append(os.path.join(os.path.expanduser("~"), ".Xauthority"))
    return [f for f in files if f and os.path.isfile(f)]


def _x11_cookies(display):
    # MIT-MAGIC-COOKIE-1 entries for this display number from the Xauthority files.
    cookies = []
    for path in _x11_auth_files():
        try:
            with open(path, "rb") as f:
                data = f.read()
        except OSError:
            continue
        pos = 0
        try:
            while pos + 2 <= len(data):
                family = struct.unpack_from(">H", data, pos)[0]
                pos += 2
                fields = []
                for _ in range(4):
                    n = struct.unpack_from(">H", data, pos)[0]
                    fields.append(data[pos + 2:pos + 2 + n])
                    pos += 2 + n
                _, number, name, cookie = fields
                if name == b"MIT-MAGIC-COOKIE-1" and number in (str(display).encode(), b"") and family in (256, 65535, 0):
                    cookies.append(cookie)
        except struct.error:
            pass
    return cookies


def _pad4(n):
    return (4 - n % 4) % 4


class X11:
    # Just enough of the X11 protocol to read two window properties, so no extra packages are needed.
    def __init__(self, display):
        last = None
        for cookie in _x11_cookies(display) + [b""]:
            try:
                self._connect(display, cookie)
                return
            except (OSError, ValueError, IndexError, struct.error) as e:
                last = e
                if getattr(self, "sock", None):
                    self.sock.close()
        raise last or OSError("X11 connection failed")

    def _connect(self, display, cookie):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(1)
        try:
            self.sock.connect(X11_SOCKET % display)
        except OSError:
            self.sock.close()
            self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            self.sock.settimeout(1)
            self.sock.connect("\0/tmp/.X11-unix/X%d" % display)  # abstract socket
        name = b"MIT-MAGIC-COOKIE-1" if cookie else b""
        self.sock.sendall(struct.pack("<BxHHHHxx", ord("l"), 11, 0, len(name), len(cookie))
                          + name + b"\0" * _pad4(len(name)) + cookie + b"\0" * _pad4(len(cookie)))
        head = self._recv(8)
        extra = self._recv(struct.unpack_from("<H", head, 6)[0] * 4)
        if head[0] != 1:
            self.sock.close()
            raise ValueError("X11 connection refused")
        vendor_len = struct.unpack_from("<H", extra, 16)[0]
        formats = extra[21]
        self.root = struct.unpack_from("<I", extra, 32 + vendor_len + _pad4(vendor_len) + 8 * formats)[0]
        self._atoms = {}

    def _recv(self, n):
        buf = b""
        while len(buf) < n:
            chunk = self.sock.recv(n - len(buf))
            if not chunk:
                raise OSError("X11 connection closed")
            buf += chunk
        return buf

    def _reply(self):
        while True:
            head = self._recv(32)
            if head[0] == 0:
                raise OSError("X11 error %d" % head[1])
            if head[0] == 1:
                return head + self._recv(struct.unpack_from("<I", head, 4)[0] * 4)
            # an event; ignore

    def atom(self, name):
        if name not in self._atoms:
            n = name.encode()
            self.sock.sendall(struct.pack("<BBHHxx", 16, 0, 2 + (len(n) + _pad4(len(n))) // 4, len(n))
                              + n + b"\0" * _pad4(len(n)))
            self._atoms[name] = struct.unpack_from("<I", self._reply(), 8)[0]
        return self._atoms[name]

    def cardinal(self, window, prop):
        # First 32-bit value of a property, or None.
        self.sock.sendall(struct.pack("<BBHIIIII", 20, 0, 6, window, self.atom(prop), 0, 0, 1))
        r = self._reply()
        fmt, length = r[1], struct.unpack_from("<I", r, 16)[0]
        return struct.unpack_from("<I", r, 32)[0] if fmt == 32 and length >= 1 else None

    def close(self):
        self.sock.close()


def _x11_displays():
    nums = []
    m = re.match(r"^(?:unix)?:(\d+)", os.environ.get("DISPLAY", ""))
    if m:
        nums.append(int(m.group(1)))
    for p in sorted(glob.glob("/tmp/.X11-unix/X*")):
        m = re.match(r".*/X(\d+)$", p)
        if m and int(m.group(1)) not in nums:
            nums.append(int(m.group(1)))
    return nums


def process_names(pid):
    # Names a program may be listed under: its process name, its file name, and for Wine/Proton
    # games the Windows .exe name (e.g. "Overwatch.exe").
    names = []
    try:
        with open("/proc/%d/comm" % pid) as f:
            names.append(f.read().strip())
    except OSError:
        pass
    try:
        names.append(os.path.basename(os.readlink("/proc/%d/exe" % pid)))
    except OSError:
        pass
    try:
        with open("/proc/%d/cmdline" % pid, "rb") as f:
            argv0 = f.read().split(b"\0")[0].decode("utf-8", "replace")
        names.append(re.split(r"[\\/]", argv0)[-1])
    except OSError:
        pass
    return [n for n in names if n]


def selected_program():
    # Names of the program whose window is selected, if it's an X11 window (XWayland included,
    # which is where Steam/Proton games run). A selected native Wayland window can't be seen: [].
    for display in _x11_displays():
        try:
            x = X11(display)
        except Exception:
            continue
        try:
            window = x.cardinal(x.root, "_NET_ACTIVE_WINDOW")
            pid = x.cardinal(window, "_NET_WM_PID") if window else None
        except Exception:
            continue
        finally:
            x.close()
        if pid:
            return process_names(pid)
    return []


# --- Keyboard (evdev) ---------------------------------------------------------------------------

EV_KEY = 0x01
EVENT = struct.Struct("llHHi")  # struct input_event on 64-bit Linux


def _ioc_read(nr, size):
    return (2 << 30) | (size << 16) | (ord("E") << 8) | nr


EVIOCGBIT_KEY = _ioc_read(0x20 + EV_KEY, 96)   # which keys the device has
EVIOCGKEY = _ioc_read(0x18, 96)                # which keys are held down right now
EVIOCGNAME = _ioc_read(0x06, 256)


def _bit(buf, n):
    return bool(buf[n // 8] & (1 << (n % 8)))


class Keyboards:
    # Reads every keyboard directly (/dev/input/event*), so the shortcuts work on KDE, GNOME and in
    # Steam's Game Mode alike. Keys still reach the selected program; nothing is grabbed.
    def __init__(self):
        import fcntl
        self._ioctl = fcntl.ioctl
        self.devices = {}       # path -> fd
        self.denied = []
        self._ignored = set()   # paths that aren't keyboards

    def rescan(self):
        self.denied = []
        paths = glob.glob("/dev/input/event*")
        self._ignored &= set(paths)  # a node's number can be reused by a newly plugged-in device
        for path in paths:
            if path in self.devices or path in self._ignored:
                continue
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except OSError as e:
                if e.errno in (errno.EACCES, errno.EPERM):
                    self.denied.append(path)
                continue
            try:
                keys = bytearray(96)
                self._ioctl(fd, EVIOCGBIT_KEY, keys)
                is_keyboard = _bit(keys, 30) and _bit(keys, 29)  # has A and Ctrl
            except OSError:
                is_keyboard = False
            if is_keyboard:
                self.devices[path] = fd
                log("Keyboard: %s (%s)", self._name(fd), path)
            else:
                os.close(fd)
                self._ignored.add(path)

    def _name(self, fd):
        buf = bytearray(256)
        try:
            self._ioctl(fd, EVIOCGNAME, buf)
        except OSError:
            return "?"
        return buf.split(b"\0")[0].decode("utf-8", "replace")

    def held_modifiers(self):
        # Asked from the devices at the moment of the key press, so a missed release can't leave a
        # modifier stuck. Modifiers on one keyboard combine with a key on another.
        held = set()
        for fd in list(self.devices.values()):
            state = bytearray(96)
            try:
                self._ioctl(fd, EVIOCGKEY, state)
            except OSError:
                continue
            for name in MODIFIER_ORDER:
                if any(_bit(state, c) for c in MODIFIERS[name]):
                    held.add(name)
        return frozenset(held)

    def read_presses(self, timeout):
        # Key codes pressed (not repeated or released) within timeout seconds.
        if not self.devices:
            time.sleep(timeout)
            return []
        ready, _, _ = select.select(list(self.devices.values()), [], [], timeout)
        presses = []
        for fd in ready:
            try:
                data = os.read(fd, EVENT.size * 64)
            except OSError as e:
                if e.errno == errno.EAGAIN:
                    continue
                self._drop(fd)  # unplugged
                continue
            for off in range(0, len(data) - EVENT.size + 1, EVENT.size):
                _, _, etype, code, value = EVENT.unpack_from(data, off)
                if etype == EV_KEY and value == 1:
                    presses.append(code)
        return presses

    def _drop(self, fd):
        for path, f in list(self.devices.items()):
            if f == fd:
                del self.devices[path]
                log("Keyboard removed: %s", path)
        try:
            os.close(fd)
        except OSError:
            pass


# --- Shortcut service --------------------------------------------------------------------------

class Daemon:
    def __init__(self, keyboards=None, create_switcher=LgSwitcher, selected=selected_program):
        self.keyboards = keyboards
        self.create_switcher = create_switcher
        self.selected = selected
        self.cfg = None
        self.switcher = None
        self.bindings = {}      # (mods, key) -> InputDef
        self._mtime = None
        self._next_detect = 0
        self._warned_denied = False

    def load(self):
        try:
            self._mtime = os.path.getmtime(CONFIG_PATH) if os.path.exists(CONFIG_PATH) else None
            self.cfg = Config.load()
        except (OSError, UnicodeError) as e:
            log("Could not read %s: %s", CONFIG_PATH, e)
            notify("Settings file not read", str(e))
            self.cfg = self.cfg or Config()
        if self.switcher is None or self.switcher.edid_id != self.cfg.edid_id.upper():
            if self.switcher:
                self.switcher.close()
            self.switcher = self.create_switcher(self.cfg.edid_id)
        self.bindings = {}
        active, failed = [], []
        for inp in self.cfg.inputs:
            if inp.hidden or inp.lg_value is None or not inp.hotkey:
                continue
            hk = parse_hotkey(inp.hotkey)
            if hk is None:
                failed.append(inp.hotkey + " (not understood)")
            elif hk in self.bindings:
                failed.append(inp.hotkey + " (already used for " + self.bindings[hk].label + ")")
            else:
                self.bindings[hk] = inp
                active.append("%s = %s" % (inp.hotkey, inp.label))
        log("Shortcuts active: %s%s; blocked programs: %s",
            ", ".join(active) or "none",
            "; NOT registered: " + ", ".join(failed) if failed else "",
            ", ".join(self.cfg.block_programs) or "none")
        if failed:
            notify("Some shortcuts were not registered", "\n".join(failed))

    def config_changed(self):
        try:
            mtime = os.path.getmtime(CONFIG_PATH) if os.path.exists(CONFIG_PATH) else None
        except OSError:
            return False
        return mtime != self._mtime

    def detect_if_needed(self):
        # The inputs are cached in the ini; until they're known, retry every 30 s.
        if self.cfg.input_codes or time.monotonic() < self._next_detect:
            return
        self._next_detect = time.monotonic() + 30
        try:
            detect_into(self.cfg, self.switcher)
            log("Detected %s: inputs %s", self.cfg.model, " ".join("%02X" % c for c in self.cfg.input_codes))
            self.load()
        except (OSError, SwitchError) as e:
            log("Couldn't read the monitor's inputs: %s", e)

    def on_press(self, key):
        if not any(k == key for _, k in self.bindings):
            return
        inp = self.bindings.get((self.keyboards.held_modifiers(), key))
        if inp is None:
            return
        names = self.selected()
        # Never switch away from a blocked program (e.g. a game) while its window is selected.
        blocked = self.cfg.is_blocked(names)
        if blocked:
            log("Shortcut %s (%s): blocked, selected window belongs to %s", inp.hotkey, inp.label, blocked)
            return
        try:
            self.switcher.switch_to(inp)
            log("Shortcut %s: switched to %s (selected window: %s)", inp.hotkey, inp.label, names[0] if names else "none/Wayland")
        except (OSError, SwitchError) as e:
            log("Shortcut %s: could not switch to %s: %s", inp.hotkey, inp.label, e)
            notify("Could not switch to " + inp.label, str(e))

    def run(self):
        log("Started")
        self.load()
        if self.keyboards is None:
            self.keyboards = Keyboards()
        last_scan = 0
        while True:
            if time.monotonic() - last_scan > 3:  # keyboards plugged in later
                self.keyboards.rescan()
                last_scan = time.monotonic()
                if not self.keyboards.devices and self.keyboards.denied and not self._warned_denied:
                    self._warned_denied = True
                    msg = "No permission to read the keyboard. Run: ujust add-user-to-input-group add, then restart the PC."
                    log(msg)
                    notify("Shortcuts are off", msg)
            if self.config_changed():
                self.load()
            self.detect_if_needed()
            for key in self.keyboards.read_presses(1.0):
                self.on_press(key)


# --- Install -----------------------------------------------------------------------------------

UNIT = """[Unit]
Description=%s (keyboard shortcuts)

[Service]
ExecStart=%s daemon
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
""" % (APP_NAME, BIN_PATH)


def _systemctl(*args):
    return subprocess.run(["systemctl", "--user"] + list(args), stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                          universal_newlines=True)


def install(cfg):
    if os.geteuid() == 0:
        print("Run install as your normal user, without sudo (it installs into your home folder).")
        return 1
    if not cfg.input_codes:
        try:
            detect_into(cfg, LgSwitcher(cfg.edid_id))
            print("Monitor: %s" % cfg.model)
        except (OSError, SwitchError) as e:
            print("Couldn't read the monitor yet (%s)\nThe service will retry; see the checks below.\n" % e)
    os.makedirs(os.path.dirname(BIN_PATH), exist_ok=True)
    me = os.path.realpath(sys.argv[0])
    if me != os.path.realpath(BIN_PATH):
        shutil.copyfile(me, BIN_PATH)
    os.chmod(BIN_PATH, 0o755)
    print("Installed " + BIN_PATH)

    # App-menu entries, one per input. Also usable as desktop shortcuts if you'd rather not let the
    # service read the keyboard (System Settings > Keyboard > Shortcuts > Add New > Application).
    os.makedirs(APPS_DIR, exist_ok=True)
    for old in glob.glob(os.path.join(APPS_DIR, APP_ID + "-*.desktop")):
        os.remove(old)
    for inp in cfg.inputs or [InputDef(c) for c in (0x0F, 0x11, 0x12)]:
        if inp.lg_value is None:
            continue
        with open(os.path.join(APPS_DIR, "%s-%s.desktop" % (APP_ID, inp.key)), "w") as f:
            f.write("[Desktop Entry]\nType=Application\nName=LG monitor: %s\n"
                    "Comment=Switch the LG monitor to %s\nExec=%s --shortcut %s\n"
                    "Icon=video-display\nTerminal=false\nStartupNotify=false\nCategories=Utility;\n"
                    % (inp.label, inp.label, BIN_PATH, inp.key))
    print("Added app-menu entries (LG monitor: ...)")

    os.makedirs(os.path.dirname(UNIT_PATH), exist_ok=True)
    with open(UNIT_PATH, "w") as f:
        f.write(UNIT)
    _systemctl("daemon-reload")
    r = _systemctl("enable", "--now", APP_ID + ".service")
    _systemctl("restart", APP_ID + ".service")
    print("Shortcut service " + ("started; it starts at every login." if r.returncode == 0 else "NOT started:\n" + r.stdout))
    print()
    return doctor(cfg)


def uninstall():
    _systemctl("disable", "--now", APP_ID + ".service")
    for path in [UNIT_PATH, BIN_PATH] + glob.glob(os.path.join(APPS_DIR, APP_ID + "-*.desktop")):
        if os.path.exists(path):
            os.remove(path)
            print("Removed " + path)
    _systemctl("daemon-reload")
    print("Settings kept in " + CONFIG_DIR)
    return 0


def doctor(cfg):
    ok = True

    def report(good, text, fix=None):
        print(("  ok   " if good else "  FIX  ") + text)
        if fix and not good:
            for line in fix.splitlines():
                print("         " + line)
        return good

    print("Monitor:")
    buses = [n for n in i2c_bus_numbers() if is_display_bus(n)]
    ok &= report(bool(i2c_bus_numbers()), "i2c-dev module loaded",
                 "sudo modprobe i2c-dev\necho i2c-dev | sudo tee /etc/modules-load.d/i2c-dev.conf")
    if i2c_bus_numbers():
        ok &= report(bool(buses), "graphics card I2C buses: " + (", ".join("i2c-%d" % n for n in buses) or "none"),
                     "The graphics driver exposes no I2C buses. NVIDIA: make sure the proprietary driver is in use.")
    denied = [n for n in buses if not os.access("/dev/i2c-%d" % n, os.R_OK | os.W_OK)]
    if buses:
        ok &= report(not denied, "permission to use them",
                     "Allow your login to use the graphics card's I2C buses, then restart the PC:\n"
                     "echo 'SUBSYSTEM==\"i2c-dev\", KERNEL==\"i2c-[0-9]*\", ATTRS{class}==\"0x03*\", TAG+=\"uaccess\"' \\\n"
                     "  | sudo tee /etc/udev/rules.d/60-lg-input-switcher.rules")
    if buses and not denied:
        switcher = LgSwitcher(cfg.edid_id)
        try:
            d = switcher.find_monitor()
            report(True, "monitor found: %s %s on i2c-%d (%s)" % (d.edid_id, d.name or "", d.bus, d.adapter))
            try:
                cur, mx = switcher.read_vcp(0x10)
                report(True, "DDC/CI works (brightness %d / %d)" % (cur, mx))
            except (OSError, SwitchError) as e:
                ok &= report(False, "DDC/CI read failed: %s" % e,
                             "Turn on DDC/CI in the monitor's menu (Settings > General), if it has the option.\n"
                             "NVIDIA: if it still fails, see the README's troubleshooting section.")
        except (OSError, SwitchError) as e:
            ok &= report(False, str(e))
        finally:
            switcher.close()

    print("Shortcuts:")
    groups = os.getgroups()
    try:
        import grp
        in_input = grp.getgrnam("input").gr_gid in groups
    except (ImportError, KeyError):
        in_input = False
    events = glob.glob("/dev/input/event*")
    readable = any(os.access(p, os.R_OK) for p in events)
    ok &= report(readable, "permission to read the keyboard" + ("" if readable or not in_input else " (group added; restart the PC)"),
                 None if in_input else "ujust add-user-to-input-group add    (then restart the PC)")
    r = _systemctl("is-active", APP_ID + ".service")
    active = r.stdout.strip() == "active"
    ok &= report(active, "shortcut service running" if active else "shortcut service not running (%s)" % r.stdout.strip(),
                 "lg-input-switcher install")
    for inp in cfg.inputs:
        if inp.hotkey and not inp.hidden and inp.lg_value is not None:
            print("         %-12s %s" % (inp.hotkey, inp.label))
    print()
    print("Settings: " + CONFIG_PATH)
    print("Log:      " + LOG_PATH)
    return 0 if ok else 1


# --- Command line ------------------------------------------------------------------------------

def print_inputs(cfg):
    print("Inputs reported by the monitor:")
    for i in cfg.inputs:
        note = "(switch code unknown)" if i.lg_value is None else "(no shortcut, hidden)" if i.hidden else ""
        print("  %-7s %-15s %-12s %s" % (i.key, i.label, i.hotkey, note))


def usage(cfg):
    print("Usage: lg-input-switcher <input> | detect | list | doctor | install | uninstall | daemon")
    print("                         probe | caps | get <vcp> | 0xNN")
    print()
    if cfg.input_codes:
        print_inputs(cfg)


def main(argv):
    cfg = Config.load()
    from_shortcut = bool(argv) and argv[0] == "--shortcut"
    if from_shortcut:
        argv = argv[1:]
    if not argv or argv[0] in ("-h", "--help", "help"):
        usage(cfg)
        return 0 if argv else 2
    cmd = argv[0].lower()

    if cmd == "list":
        problems = []
        displays = list_displays(problems)
        for d in displays:
            mine = d.edid_id and d.edid_id.upper() == cfg.edid_id.upper()
            print("i2c-%-3d edid=%-8s name=%-16s %s%s" % (d.bus, d.edid_id or "?", d.name or "?", d.adapter,
                                                         "  <- configured monitor" if mine else ""))
        hint = access_help(problems)
        if hint:
            print(hint, file=sys.stderr)
        return 0 if displays else 1
    if cmd == "doctor":
        return doctor(cfg)
    if cmd == "install":
        return install(cfg)
    if cmd == "uninstall":
        return uninstall()
    if cmd == "daemon":
        try:
            Daemon().run()
        except KeyboardInterrupt:
            return 0

    switcher = LgSwitcher(cfg.edid_id)
    if cmd == "probe":
        # Read-only DDC check: reads brightness (VCP 0x10) over the same I2C path.
        print("DDC OK: brightness %d / %d" % switcher.read_vcp(0x10))
        return 0
    if cmd == "caps":
        print(switcher.read_capabilities())
        return 0
    if cmd == "get" and len(argv) >= 2:
        cur, mx = switcher.read_vcp(parse_byte(argv[1]))
        print("VCP %s: current 0x%04X max 0x%04X" % (argv[1], cur, mx))
        return 0
    if cmd.startswith("0x"):
        # Raw LG 0xF4 value, sent as-is (for experimenting with other models).
        raw = parse_byte(cmd)
        switcher.switch_input(raw)
        print("Sent LG input value 0x%02X" % raw)
        return 0
    if cmd == "detect" or not cfg.input_codes:
        detect_into(cfg, switcher)
        if cmd == "detect":
            print(cfg.model)
            print_inputs(cfg)
            return 0

    inp = cfg.find(cmd)
    if inp is None:
        usage(cfg)
        return 2
    if from_shortcut:
        # Started by a desktop shortcut: same rule as the service's shortcuts.
        names = selected_program()
        blocked = cfg.is_blocked(names)
        if blocked:
            log("Shortcut for %s: blocked, selected window belongs to %s", inp.label, blocked)
            return 0
    switcher.switch_to(inp)
    if from_shortcut:
        log("Shortcut: switched to %s", inp.label)
    print("Switched to " + inp.label)
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except (OSError, SwitchError) as e:
        print("Error: %s" % e, file=sys.stderr)
        if "--shortcut" in sys.argv:
            notify("Could not switch input", str(e))
        sys.exit(1)

class SwitchError(Exception):
    pass


# --- Log ---------------------------------------------------------------------------------------

def log(fmt, *args):
    # Shortcut presses, the selected program, blocks and switch results. Also printed for journalctl.
    line = time.strftime("%Y-%m-%d %H:%M:%S") + "  " + (fmt % args if args else fmt)
    try:
        os.makedirs(os.path.dirname(LOG_PATH), exist_ok=True)
        if os.path.exists(LOG_PATH) and os.path.getsize(LOG_PATH) > 256 * 1024:
            with open(LOG_PATH, encoding="utf-8", errors="replace") as f:
                text = f.read()
            text = text[len(text) // 2:]  # keep the newer half
            with open(LOG_PATH, "w", encoding="utf-8") as f:
                f.write(text[text.find("\n") + 1:])
        with open(LOG_PATH, "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except OSError:
        pass  # logging must never break switching
    if os.environ.get("INVOCATION_ID") or sys.stderr.isatty():  # under systemd this goes to the journal
        print(line, file=sys.stderr, flush=True)


def notify(summary, body):
    # Desktop notification through D-Bus (gdbus ships with every GNOME and KDE system).
    def gv(s):
        return "'" + s.replace("\\", "\\\\").replace("'", "\\'").replace("\n", "\\n") + "'"
    try:
        subprocess.run(["gdbus", "call", "--session", "--dest", "org.freedesktop.Notifications",
                        "--object-path", "/org/freedesktop/Notifications",
                        "--method", "org.freedesktop.Notifications.Notify",
                        gv(APP_NAME), "0", gv("video-display"), gv(summary), gv(body), "[]", "{}", "6000"],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.SubprocessError):
        pass


# --- Inputs and settings -----------------------------------------------------------------------

# VCP 0x60 input code: key, label, LG 0xF4 value (None = unknown)
KNOWN_INPUTS = {
    0x01: ("vga1", "VGA 1", None),
    0x02: ("vga2", "VGA 2", None),
    0x03: ("dvi1", "DVI 1", None),
    0x04: ("dvi2", "DVI 2", None),
    0x0F: ("dp1", "DisplayPort 1", 0xD0),
    0x10: ("dp2", "DisplayPort 2", 0xD1),
    0x11: ("hdmi1", "HDMI 1", 0x90),
    0x12: ("hdmi2", "HDMI 2", 0x91),
    0x1B: ("usbc", "USB-C", None),
}


class InputDef:
    def __init__(self, code):
        self.code = code
        if code in KNOWN_INPUTS:
            self.key, self.label, self.lg_value = KNOWN_INPUTS[code]
        else:
            self.key, self.label, self.lg_value = "input%02x" % code, "Input 0x%02X" % code, None
        self.hotkey = ""
        self.hidden = False


class Config:
    # Same format as the Windows version's lg-input-switcher.ini:
    #   [monitor]  edid, model and inputs (detected from the monitor)
    #   [hotkeys]  hdmi1 = Ctrl+Alt+2
    #   [menu]     hide = dp2
    #   [block]    programs = Overwatch.exe
    def __init__(self):
        self.edid_id = ""  # empty: the first LG monitor found
        self.model = ""
        self.input_codes = []
        self.hotkeys = {}
        self.hidden = set()
        self.block_programs = []

    @staticmethod
    def load(path=None):
        path = path or CONFIG_PATH
        if os.path.exists(path):
            with open(path, encoding="utf-8", errors="replace") as f:
                return Config.parse(f.read().splitlines())
        # First run: default shortcuts; the inputs themselves are detected from the monitor.
        cfg = Config()
        cfg.hotkeys = {"dp1": "Ctrl+Alt+1", "hdmi1": "Ctrl+Alt+2", "hdmi2": "Ctrl+Alt+3"}
        return cfg

    @staticmethod
    def parse(lines):
        cfg = Config()
        section = ""
        for raw in lines:
            line = raw.strip()
            if not line or line.startswith(";") or line.startswith("#"):
                continue
            if line.startswith("[") and line.endswith("]"):
                section = line[1:-1].strip().lower()
                continue
            if "=" not in line:
                continue
            key, val = line.split("=", 1)
            key, val = key.strip().lower(), val.strip()
            if section == "monitor":
                if key == "edid":
                    cfg.edid_id = val
                elif key == "model":
                    cfg.model = val
                elif key == "inputs":
                    # Skip malformed codes rather than failing the whole file.
                    for c in re.split(r"[ ,]+", val):
                        try:
                            code = int(c, 16)
                        except ValueError:
                            continue
                        if 0 <= code <= 0xFF and code not in cfg.input_codes:
                            cfg.input_codes.append(code)
            elif section == "hotkeys" and val:
                cfg.hotkeys[key] = val
            elif section == "menu" and key == "hide":
                cfg.hidden.update(h.lower() for h in re.split(r"[ ,]+", val) if h)
            elif section == "block" and key == "programs":
                cfg.block_programs.extend(p.strip() for p in val.split(",") if p.strip())
        return cfg

    def save(self, path=None):
        path = path or CONFIG_PATH
        os.makedirs(os.path.dirname(path), exist_ok=True)
        out = [
            "; %s settings. Edit by hand; the shortcut service picks up changes by itself." % APP_NAME,
            "",
            "[monitor]",
            "; Detected from the monitor (EDID and DDC capabilities). Run \"lg-input-switcher detect\" to refresh.",
            "edid = " + self.edid_id,
            "model = " + self.model,
            "inputs = " + " ".join("%02X" % c for c in self.input_codes),
            "",
            "[hotkeys]",
            "; input = Ctrl/Alt/Shift/Win + a key name (1, F9, Home, NumPad1, ...)",
        ]
        out += ["%s = %s" % (k, v) for k, v in self.hotkeys.items() if v]
        out += [
            "",
            "[menu]",
            "; Inputs that get no shortcut (space-separated).",
            "hide = " + " ".join(sorted(self.hidden)),
            "",
            "[block]",
            "; Shortcuts do nothing while a window of one of these programs is selected (comma-separated).",
            "; Running in the background or minimized doesn't count. Works for X11/XWayland windows,",
            "; which includes Steam/Proton games; use the Windows name for those, e.g. Overwatch.exe.",
            "programs = " + ", ".join(self.block_programs),
        ]
        tmp = path + ".tmp"
        with open(tmp, "w", encoding="utf-8") as f:
            f.write("\n".join(out) + "\n")
        os.replace(tmp, path)

    @property
    def inputs(self):
        result = []
        for code in self.input_codes:
            d = InputDef(code)
            d.hotkey = self.hotkeys.get(d.key, "")
            d.hidden = d.key in self.hidden
            result.append(d)
        return result

    def find(self, key):
        key = {"dp": "dp1", "hdmi": "hdmi1"}.get(key.lower(), key.lower())
        return next((i for i in self.inputs if i.key == key), None)

    def is_blocked(self, names):
        # Matches "Overwatch.exe" or "Overwatch" against any of the program's names.
        def bare(n):
            n = n.lower()
            return n[:-4] if n.endswith(".exe") else n
        for name in names:
            if not name:
                continue
            for p in self.block_programs:
                if p.lower() == name.lower() or bare(p) == bare(name):
                    return p
        return None


def parse_byte(s):
    s = s.strip()
    return int(s[2:], 16) if s.lower().startswith("0x") else int(s)



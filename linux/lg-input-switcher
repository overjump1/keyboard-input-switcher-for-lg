def _xdg(var, fallback):
    return os.environ.get(var) or os.path.join(os.path.expanduser("~"), fallback)


CONFIG_DIR = os.path.join(_xdg("XDG_CONFIG_HOME", ".config"), APP_ID)
CONFIG_PATH = os.path.join(CONFIG_DIR, APP_ID + ".ini")
